# /etc/systemd/system/axp-battery-config.service
#
# Re-apply AXP228 battery settings on every boot. The AXP keeps these registers
# only while it is powered, so they are lost on every full power loss.
#
#   CHGLED               register 0x32 bit 3 = 1: the orange charge LED follows the charger
#                        (on while charging, off when done). The default 0x43 leaves the
#                        pin under manual control, i.e. dark. Read-modify-write via -m.
#   voltage_min  3.2 V   discharge cutoff (register 0x31 = 0x06; default 2.9 V)
#   0xE0/0xE1            fuel-gauge pack capacity = what the pack DELIVERS in this system, not its
#                        label. Measured for this fork's cell (labelled 10 000 mAh): 7583 mAh from a
#                        terminated charge to the 3.50 V guard at ~1.3 A (docs/battery.md):
#                        7583 / 1.456 = 5208 = 0x1458 -> 0xE0 = 0x14 | 0x80 (valid bit) = 0x94, 0xE1 = 0x58
#
# Measure your own pack and adjust the two capacity bytes (docs/battery.md has the procedure)
# and confirm the I2C bus number with `i2cdetect -l` (9 = the i2c-axp adapter
# in this build; it depends on probe order).

[Unit]
Description=AXP228: charge LED, 3.2 V cutoff and measured pack capacity (values do not survive power loss)
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'i2cset -f -y -m 0x08 9 0x34 0x32 0x08; echo 3200000 > /sys/class/power_supply/axp20x-battery/voltage_min; i2cset -f -y 9 0x34 0xE0 0x94; i2cset -f -y 9 0x34 0xE1 0x58'

[Install]
WantedBy=multi-user.target
