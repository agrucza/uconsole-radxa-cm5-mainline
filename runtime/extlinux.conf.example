## /boot/extlinux/extlinux.conf
##
## IMPORTANT WARNING
##
## The configuration of this file is generated automatically.
## Do not edit this file manually, use: u-boot-update

default uconsole-726-aio
menu title U-Boot menu
prompt 1
timeout 10

label l0
    menu label Debian GNU/Linux 12 (bookworm) 6.1.84-8-rk2410
    linux /boot/vmlinuz-6.1.84-8-rk2410
    initrd /boot/initrd.img-6.1.84-8-rk2410
    fdtdir /usr/lib/linux-image-6.1.84-8-rk2410/
    append root=UUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx console=ttyFIQ0,1500000n8 quiet splash loglevel=4 rw earlycon consoleblank=0 console=tty1 coherent_pool=2M irqchip.gicv3_pseudo_nmi=0 cgroup_enable=cpuset cgroup_memory=1 cgroup_enable=memory swapaccount=1

label l0r
    menu label Debian GNU/Linux 12 (bookworm) 6.1.84-8-rk2410 (rescue target)
    linux /boot/vmlinuz-6.1.84-8-rk2410
    initrd /boot/initrd.img-6.1.84-8-rk2410
    fdtdir /usr/lib/linux-image-6.1.84-8-rk2410/
    append root=UUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx console=ttyFIQ0,1500000n8 splash loglevel=4 rw earlycon consoleblank=0 console=tty1 coherent_pool=2M irqchip.gicv3_pseudo_nmi=0 cgroup_enable=cpuset cgroup_memory=1 cgroup_enable=memory swapaccount=1 single
    
label uconsole-72-mainline
    menu label uConsole mainline 7.2.3 (tdeval)
    linux /boot/Image-7.2
    fdt /boot/dtb-7.2/rk3588s-radxa-cm5-uconsole.dtb
    append root=PARTUUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx rootfstype=ext4 rootwait rw console=ttyS4,1500000 console=tty1 consoleblank=0 loglevel=7 panic=10

label uconsole-726-aio
    menu label uConsole mainline 7.2.6 (AIO DTB, battery 10 Ah, no serial console)
    linux /boot/Image-7.2.6
    fdt /boot/dtb-7.2.6/rk3588s-radxa-cm5-uconsole-aio.dtb
    append root=PARTUUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx rootfstype=ext4 rootwait rw console=tty1 consoleblank=0 loglevel=7 panic=10